# Copy this file to .env and fill in your own values.
# .env is gitignored - do not commit it.

PORT=3000
SITE_NAME=Kutt
DEFAULT_DOMAIN=localhost:3000

# any long random string
JWT_SECRET=

# Neon Postgres - paste your own project's values
DB_CLIENT=pg
DB_HOST=your-host.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=your_user
DB_PASSWORD=your_password
DB_SSL=true

# allow signup + anonymous links so we can test them
DISALLOW_REGISTRATION=false
DISALLOW_ANONYMOUS_LINKS=false

# email -> Mailpit (inbox at http://localhost:8025)
MAIL_ENABLED=true
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_FROM=Kutt <test@localhost>
